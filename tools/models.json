      "body_remap": ["+y", "+z", "+x"],
      "scale": 1.0,
      "origin": "center",
      "max_tex": 2048,
      "max_tris": 60000,
      "rules": [
        ["_drop", "Flame|beacon|strobe|^Light\\.|^blah\\.|^lens\\."],
        ["canopy", "^canopy"],
        ["gear", "^gear|^nosegear|^wheel|^nosewheel|^geardoor"],
        ["aileron_l", "^flaperon\\.L|^flaperon1\\.L"],
        ["aileron_r", "^flaperon\\.R|^flaperon1\\.R"],
        ["elevator_l", "^elevator\\.L$"],
        ["elevator_r", "^elevator\\.R$"],
        ["rudder", "^rudder$"],
        ["speedbrake", "^speedbrake$"],
        ["nozzle", "^Mesh153\\.007$"]
      ],
      "anim": {
        "canopy": "canopyframe",
        "elevator_l": "elevator.L",
        "elevator_r": "elevator.R",
        "rudder": "rudder",
        "aileron_l": "flaperon.L",
        "aileron_r": "flaperon.R",
        "speedbrake": "speedbrake"
      },
      "hinges": {},
      "nozzle": "^Mesh153\\.007$",
      "wing": "^wing\\.01[LR]$",
      "cockpit": "^canopyglass$",
      "muzzles_raw": []
    },
    "f35a": {
      "kind": "aircraft",
      "repo": "PaoloAmoroso/F-35A",
      "branch": "main",
      "src": "tools/cache/models/src-f35a",
      "sparse": ["Models/*.ac", "Models/*.xml", "Models/*.png"],
      "entry": "Models/F-35A.xml",
      "include_models": [],
      "offset_overrides": {},
      "source": "https://github.com/PaoloAmoroso/F-35A (Models/F-35A.xml, F-35A.ac)",
      "license": "GPL-2.0",
      "out": "game/assets/models/aircraft/f35a/f35a.glb",
      "remap": ["-z", "+y", "+x"],
      "body_remap": ["+y", "+z", "+x"],
      "scale": 1.0,
      "origin": "center",
      "max_tex": 2048,
      "max_tris": 60000,
      "rules": [
        ["_drop", "PilotBody|PilotHead|SeatandStraps|EjectionSeat|SensorBall|Pedal|Switches|Display|InstrumentGlass|Console|Panels|CockpitControls|Visor|LadderBit"],
        ["canopy", "^CanopyFrame$|^CanopyFrame2$|^CanopyFrameWire$|^CanopyGlass$|^CanopyBits$"],
        ["gear", "Wheel|Strut|Spring|Actuator|Gear|NoseLower|NoseUpper"],
        ["aileron_l", "^PortElevon$"],
        ["aileron_r", "^StarboardElevon$"],
        ["flap_l", "^PortFlap$"],
        ["flap_r", "^StarboardFlap$"],
        ["rudder_l", "^PortRudder$"],
        ["rudder_r", "^StarboardRudder$"]
      ],
      "anim": {
        "canopy": "CanopyFrame"
      },
      "hinges": {
        "aileron_l": { "center": [5.03, 0.0, 0.19], "axis": [0, 1, 0], "max_deg": 20, "property": "sim/multiplay/generic/float[4]" },
        "aileron_r": { "center": [5.03, 0.0, 0.19], "axis": [0, -1, 0], "max_deg": 20, "property": "sim/multiplay/generic/float[4]" },
        "flap_l": { "center": [3.15, 0.0, 0.15], "axis": [0, -1, 0], "max_deg": 35, "property": "surface-positions/flap-pos-norm" },
        "flap_r": { "center": [3.15, 0.0, 0.15], "axis": [0, 1, 0], "max_deg": 35, "property": "surface-positions/flap-pos-norm" },
        "rudder_l": { "center": [5.62, -1.76, 0.45], "axis": [0, 0, -1], "max_deg": 35, "property": "surface-positions/rudder-pos-norm" },
        "rudder_r": { "center": [5.61, 1.74, 0.45], "axis": [0, 0, -1], "max_deg": 35, "property": "surface-positions/rudder-pos-norm" }
      },
      "nozzle": "^NOPE$",
      "wing": "^PortElevon$|^StarboardElevon$",
      "cockpit": "^CanopyGlass$",
      "muzzles_raw": []
    }
  }
}
