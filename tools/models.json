{
  "_comment": "Source recipes for tools/convert_models.py (Blender) and tools/fetch_models.sh. Frames: remap maps AC3D raw axes to Godot (+X right, +Y up, -Z nose). AC3D raw in the FlightGear F-16 is x aft, y up, z left (verified against the animation centres). body_remap maps the FlightGear body frame (x aft, y right, z up) used by XML offsets and animations. rules: [bucket, regex] on AC3D object names, first match wins, '_drop' removes the object, unmatched objects go to 'airframe'. anim: bucket -> FG animation object-name giving the hinge (center/axis/max from the XML). hinges: bucket -> hinge in body frame where the XML animation is commented out (center, axis, max_deg, property). offset_overrides: model name -> body offset that replaces the XML <offsets>. scale: meters per AC3D unit (no fit).",
  "models": {
    "f16c": {
      "kind": "aircraft",
      "repo": "NikolaiVChr/f16",
      "branch": "master",
      "src": "tools/cache/models/src-f16",
      "sparse": ["Models/*.ac", "Models/*.xml", "Models/*.png", "Models/*.dds"],
      "entry": "Models/F-16.xml",
      "include_models": ["GE_nozzle", "irst"],
      "offset_overrides": { "GE_nozzle": [-3.12715, -1.4827, 1.25336] },
      "source": "https://github.com/NikolaiVChr/f16 (Models/F-16.xml, f16.ac, nozzle-GE.ac, irst-b60.ac)",
      "license": "GPL-2.0",
      "out": "game/assets/models/aircraft/f16c/f16c.glb",
      "remap": ["-z", "+y", "+x"],
      "body_remap": ["+y", "+z", "+x"],
      "scale": 1.0,
      "origin": "center",
      "max_tex": 2048,
      "max_tris": 60000,
      "rules": [
        ["_drop", "Flame|Chute|Smoke"],
        ["canopy", "^Canopy"],
        ["gear", "Tire|Strut|GearDoor|MainDoor"],
        ["aileron_l", "^LeftLowerAileron|^LeftUpperAileron"],
        ["aileron_r", "^RightLowerAileron|^RightUpperAileron"],
        ["elevator_l", "^LeftUpperHorizonTail|^LeftLowerHorizonTail"],
        ["elevator_r", "^RightUpperHorizonTail|^RightLowerHorizonTail"],
        ["rudder", "^Rudder|^VstabBand"],
        ["flap_l", "^LeftUpperFlap|^LeftLowerFlap"],
        ["flap_r", "^RightUpperFlap|^RightLowerFlap"],
        ["speedbrake_l", "^LeftUpperSpeedbrake|^LeftLowerSpeedbrake"],
        ["speedbrake_r", "^RightUpperSpeedbrake|^RightLowerSpeedbrake"],
        ["nozzle", "^InNozzle|^NozzlePetal"]
      ],
      "anim": {
        "canopy": "CanopyFrame",
        "elevator_l": "LeftUpperHorizonTail",
        "elevator_r": "RightUpperHorizonTail",
        "rudder": "Rudder",
        "flap_l": "LeftUpperFlap",
        "flap_r": "RightUpperFlap",
        "speedbrake_l": "LeftUpperSpeedbrake",
        "speedbrake_r": "RightUpperSpeedbrake"
      },
      "hinges": {
        "aileron_l": { "center": [1.5233, -2.3235, 0.1224], "axis": [-0.39329, 2.5165, 0.09696], "max_deg": 21.5, "property": "surface-positions/left-aileron-pos-norm" },
        "aileron_r": { "center": [1.5233, 2.3235, 0.1224], "axis": [-0.39329, -2.5165, 0.09696], "max_deg": 21.5, "property": "surface-positions/right-aileron-pos-norm" }
      },
      "nozzle": "^InNozzle|^NozzlePetal",
      "wing": "^WingTips$",
      "cockpit": "^canopy$",
      "muzzles_raw": [[-0.9, 0.6, -4.5]]
    },
    "ef2000": {
      "kind": "aircraft",
      "repo": "IAHM-COL/EF-Typhoon",
      "branch": "master",
