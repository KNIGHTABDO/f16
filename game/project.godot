; Engine configuration file.
config_version=5

[application]

config/name="Knight Wings"
config/description="Combat flight game for iPhone/iPad"
run/main_scene="res://ui/menu/menu_root.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon_1024.png"
run/max_fps=0

[autoload]

WorldOrigin="*res://autoload/world_origin.gd"
Events="*res://autoload/events.gd"
Settings="*res://autoload/settings.gd"
GameState="*res://autoload/game_state.gd"
Ground="*res://autoload/ground.gd"
Sfx="*res://autoload/sfx.gd"
Vfx="*res://autoload/vfx.gd"
Radio="*res://autoload/radio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
sensors/enable_accelerometer=true
sensors/enable_gravity=true
sensors/enable_gyroscope=true

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="aircraft"
3d_physics/layer_3="ground_units"
3d_physics/layer_4="structures"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
camera/depth_far_default=60000
